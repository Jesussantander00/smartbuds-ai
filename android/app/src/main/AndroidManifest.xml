<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice Engine: escuchar los comandos de voz mientras la app esta abierta. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Visualizador que responde al audio (Visualizer de Android). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Reproductor propio: buscar y reproducir canciones del catálogo (Audius). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Escucha con pantalla apagada: servicio en primer plano de tipo micrófono. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: mostrar la notificación «SmartBuds está escuchando». -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+: necesario para mostrar el nombre de las apps de música
         detectadas (visibilidad de paquetes). -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Ecualizador del teléfono (Samsung, Dolby, Xiaomi…). -->
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <!-- Voz de respuesta (TextToSpeech) en Android 11+. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Android 11+: necesario para usar el reconocedor de voz del sistema. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="SmartBuds AI"
        android:name=".SmartBudsApplication"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Accesos rápidos al mantener presionado el ícono. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Widget de la pantalla de inicio. -->
        <receiver
            android:name=".SmartBudsWidget"
            android:exported="false"
            android:label="SmartBuds">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smartbuds_widget_info" />
        </receiver>

        <!-- Mantiene la escucha con la pantalla apagada. -->
        <service
            android:name=".VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Autorizado por el usuario en Ajustes → Acceso a notificaciones.
             Permite a MediaSessionManager listar las sesiones activas. -->
        <service
            android:name=".SmartBudsNotificationListener"
            android:label="SmartBuds AI — detección de reproductor"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
